# Copy to .env and fill in before running docker compose up.
# (This file documents the variables cnlp-docker-hosting's docker-compose.yml
# expects in academic-reading/.env — see that repo's env_file: entry.)

SECRET_KEY=change-me-to-a-long-random-string

# The app is mounted behind a reverse proxy subpath in production. Caddy's
# `handle_path /academic-reading/*` strips the prefix before proxying, so
# these tell Django to add it back into generated URLs/redirects/static links.
PUBLIC_PATH=/academic-reading/
FORCE_SCRIPT_NAME=/academic-reading
STATIC_URL=/academic-reading/static/

DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=cnlp.langcen.cam.ac.uk,127.0.0.1,0.0.0.0,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://cnlp.langcen.cam.ac.uk

# MariaDB — used by both the app and mariadb services in the shared compose.
# Named _v1 to distinguish from the sibling academic-reading-eng app's DB.
MARIADB_USER=academic_reading_v1
MARIADB_PASSWORD=change-me-to-a-long-random-string
MARIADB_ROOT_PASSWORD=change-me-to-a-different-long-random-string
DATABASE_URL=mysql://academic_reading_v1:change-me-to-a-long-random-string@mariadb_academic_reading_v1:3306/academic_reading_v1

# Ollama Cloud — the only LLM backend in this build.
OLLAMA_API_KEY=

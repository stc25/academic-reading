# Copy to .env and fill in before running docker compose up.
# (Documents the variables the Docker Compose stack in the repository root reads
# from this app's .env via env_file:.)

SECRET_KEY=change-me-to-a-long-random-string

# The app is mounted behind a reverse proxy subpath in production. Caddy's
# `handle_path /academic-reading-eng/*` strips the prefix before proxying, so
# these tell Django to add it back into generated URLs/redirects/static links.
PUBLIC_PATH=/academic-reading-eng/
FORCE_SCRIPT_NAME=/academic-reading-eng
STATIC_URL=/academic-reading-eng/static/

DJANGO_DEBUG=false
# Your public hostname (see the root README):
DJANGO_ALLOWED_HOSTS=your.hostname.example,127.0.0.1,0.0.0.0,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://your.hostname.example

# MariaDB — used by both the app and mariadb services in the shared compose.
MARIADB_USER=academic_reading_eng
MARIADB_PASSWORD=change-me-to-a-long-random-string
MARIADB_ROOT_PASSWORD=change-me-to-a-different-long-random-string
DATABASE_URL=mysql://academic_reading_eng:change-me-to-a-long-random-string@mariadb_academic_reading:3306/academic_reading_eng

# Ollama Cloud — the only LLM backend in this build.
OLLAMA_API_KEY=

# ── Sign-in (all dormant until switched on) ──────────────────────────────────
# With AUTH_REQUIRED unset/false the app behaves exactly as before: anonymous,
# history kept per browser. Set it to true to require sign-in; history is then
# kept per account. See docs/LOGIN.md for the switch-over runbook.
AUTH_REQUIRED=false
# University Microsoft (Entra ID) SSO. The button stays hidden until both are set.
# Redirect URI to register:
#   https://your.hostname.example/academic-reading-eng/auth/sso/complete/azuread-tenant-oauth2/
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# AZURE_TENANT_ID defaults to the University of Cambridge tenant.
# Email + password accounts for people outside cam.ac.uk (admin-created; the person
# gets a set-password email). Needs working SMTP below.
EMAIL_PASSWORD_LOGIN_ENABLED=false
EMAIL_BACKEND=django.core.mail.backends.filebased.EmailBackend
EMAIL_HOST=
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
DEFAULT_FROM_EMAIL=
# Optional login reporting; does nothing unless all three are set.
MONITOR_URL=
MONITOR_TOKEN=
MONITOR_APP_NAME=
